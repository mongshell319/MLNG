# Supabase 를 붙이면 세계 상태가 worlds 테이블로 가고,
# 클라이언트는 그 행의 postgres_changes 를 구독한다.
#
# 세 값을 비워 두면 로컬 어댑터로 돈다 — 파일에 얹힌 인메모리 상태 + SSE.
# 개발과 시연에서는 이대로도 세 화면이 실제로 함께 움직인다.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 쓰기는 전부 이 키로만 일어난다 (RLS 우회).
# 절대 클라이언트 번들에 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
