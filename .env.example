# ── 세션 서명 ────────────────────────────────────────────
# 쿠키 위조를 막는 유일한 값이다. 32자 이상이어야 하고,
# 없으면 프로덕션 빌드가 아예 뜨지 않는다.
#   openssl rand -base64 48
SESSION_SECRET=

# ── Supabase ─────────────────────────────────────────────
# 프로덕션에서는 필수다. 로컬 어댑터(파일 + SSE)는 인스턴스 하나에서만
# 성립하므로 서버가 두 대 뜨는 순간 세계가 갈라진다 — 그래서 막아 뒀다.
#
# 개발 중에는 셋 다 비워 두면 로컬 어댑터로 돈다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 세계에 대한 쓰기와 사진 업로드는 전부 이 키로만 일어난다(RLS 우회).
# 절대 클라이언트 번들에 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 브라우저의 Realtime 구독 토큰을 서명할 때 쓴다.
# Supabase 대시보드 → Project Settings → API → JWT Secret.
# 이 값이 없으면 실시간 구독이 붙지 않는다.
SUPABASE_JWT_SECRET=
